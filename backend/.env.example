# =========================================================
# ENVIRONMENT
# =========================================================
NODE_ENV=development
PORT=5000

# =========================================================
# DATABASE — MySQL
# =========================================================
DATABASE_URL="mysql://root:your_password@localhost:3306/plenary"

# =========================================================
# JWT
# =========================================================
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d

# =========================================================
# GOOGLE OAUTH (WAJIB untuk Google Login)
# =========================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# =========================================================
# TIKTOK OAUTH (siapkan saat credentials tersedia)
# =========================================================
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_CALLBACK_URL=http://localhost:5000/api/auth/tiktok/callback

# =========================================================
# FACEBOOK OAUTH (siapkan saat credentials tersedia)
# =========================================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# =========================================================
# PLENARY DOMAIN & ADMIN CONTACT
# =========================================================
PLENARY_DOMAIN=plenary.id
ADMIN_EMAIL=admin@plenary.id
SUPPORT_EMAIL=support@plenary.id
ADMIN_WHATSAPP=6282119729450

# =========================================================
# EMAIL SERVICE
# =========================================================
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@plenary.id
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=PLENARY <noreply@plenary.id>

# =========================================================
# WHATSAPP BUSINESS API
# =========================================================
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# =========================================================
# PAYMENT PROVIDER
# =========================================================
PAYMENT_PROVIDER=midtrans
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SERVER_KEY=your_payment_server_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret
PAYMENT_IS_PRODUCTION=false

# =========================================================
# FRONTEND URL
# =========================================================
FRONTEND_URL=http://localhost:3000
