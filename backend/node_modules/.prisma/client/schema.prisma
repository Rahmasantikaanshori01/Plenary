generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================
// USER
// =========================================================

model User {
  id       String  @id @default(uuid())
  email    String? @unique
  username String? @unique
  password String?
  role     Role    @default(BUYER)

  // OAuth
  googleId   String? @unique
  facebookId String? @unique
  tiktokId   String? @unique

  // Loyalty
  loyaltyPoints Int @default(0)

  // Force password change on first login
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  buyerProfile        BuyerProfile?
  sellerProfile       SellerProfile?
  sellerVerification  SellerVerification?
  staffProfile        StaffProfile?
  orders              Order[]
  tickets             Ticket[]
  wishlists           Wishlist[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  loyaltyTransactions LoyaltyTransaction[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

enum Role {
  ADMIN
  BUYER
  SELLER
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

// =========================================================
// BUYER PROFILE
// =========================================================

model BuyerProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  nik       String    @unique
  age       Int?
  birthDate DateTime?
  gender    Gender?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

// =========================================================
// SELLER PROFILE
// =========================================================

model SellerProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  nik                String?   @unique
  ownerName          String?
  age                Int?
  birthDate          DateTime?
  gender             Gender?
  storeName          String
  storeDescription   String?   @db.Text
  storeAddress       String?
  storeEmail         String?   @unique
  accountCode        String    @unique
  subscriptionType   SubType   @default(FREE)
  subscriptionExpiry DateTime?
  eventAccessDays    Int       @default(7)
  sponsoredBy        String?

  // Organization / Dinaungi Oleh
  organizationName String?
  organizationType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         Event[]
  staff          StaffProfile[]
  subscriptions  Subscription[]
  sellerMessages SellerMessage[]
  orderItems     OrderItem[]

  @@map("seller_profiles")
}

enum SubType {
  FREE
  PAID_1M
  PAID_3M
}

// =========================================================
// SELLER APPLICATION
// =========================================================

model SellerApplication {
  id String @id @default(uuid())

  // Applicant / Pemilik Akun
  nik       String
  ownerName String
  age       Int
  birthDate DateTime
  gender    Gender

  // Store Info
  storeName        String
  storeDescription String? @db.Text
  storeAddress     String
  storeEmail       String
  sponsoredBy      String?

  // Organization / Dinaungi Oleh
  organizationName String?
  organizationType String?

  // Application
  status     ApplicationStatus @default(PENDING)
  adminNotes String?           @db.Text
  channel    String? // "whatsapp", "email", "web"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("seller_applications")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================================================
// SELLER VERIFICATION
// =========================================================

model SellerVerification {
  id               String       @id @default(uuid())
  userId           String       @unique
  nik              String
  ownerName        String
  age              Int
  birthDate        DateTime
  gender           Gender
  storeName        String
  storeDescription String?      @db.Text
  storeAddress     String
  storeEmail       String
  status           VerifyStatus @default(PENDING)
  adminNotes       String?      @db.Text
  accountCode      String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?      @db.Text

  // Organization / Dinaungi Oleh
  organizationName String?
  organizationType String?
  sponsoredBy      String?

  // Link to application if exists
  applicationId String?
  adminId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_verifications")
}

enum VerifyStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================================================
// SELLER MESSAGE
// =========================================================

model SellerMessage {
  id                String  @id @default(uuid())
  applicationId     String?
  sellerId          String?
  channel           String // "whatsapp" | "email"
  direction         String // "incoming" | "outgoing"
  sender            String?
  recipient         String?
  subject           String?
  body              String  @db.Text
  externalMessageId String?
  read              Boolean @default(false)
  status            String  @default("received") // "received", "sent", "failed"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([read])
  @@map("seller_messages")
}

// =========================================================
// STAFF PROFILE
// =========================================================

model StaffProfile {
  id       String  @id @default(uuid())
  userId   String  @unique
  sellerId String
  name     String?
  email    String?
  status   String  @default("ACTIVE") // ACTIVE, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("staff_profiles")
}

// =========================================================
// EVENT
// =========================================================

model Event {
  id          String      @id @default(uuid())
  sellerId    String
  name        String
  description String?     @db.Text
  banner      String?
  location    String
  date        DateTime
  time        String?
  category    String
  saleStart   DateTime
  saleEnd     DateTime
  status      EventStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  orders      Order[]
  orderItems  OrderItem[]
  wishlists   Wishlist[]
  tickets     Ticket[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([date])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ONGOING
  SOLD_OUT
  COMPLETED
  EXPIRED
  CANCELLED
}

// =========================================================
// TICKET TYPE
// =========================================================

model TicketType {
  id           String           @id @default(uuid())
  eventId      String
  name         String
  price        Float
  quantity     Int
  quantitySold Int              @default(0)
  saleStart    DateTime?
  saleEnd      DateTime?
  status       TicketTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

// =========================================================
// ORDER
// =========================================================

model Order {
  id          String      @id @default(uuid())
  buyerId     String
  eventId     String
  sellerId    String?
  status      OrderStatus @default(PENDING)
  totalAmount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer      User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  payment    Payment?
  tickets    Ticket[]

  @@index([buyerId])
  @@index([eventId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

// =========================================================
// ORDER ITEM
// =========================================================

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  eventId      String
  ticketTypeId String
  sellerId     String?
  quantity     Int
  price        Float
  subtotal     Float

  createdAt DateTime @default(now())

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  tickets    Ticket[]

  @@index([orderId])
  @@index([eventId])
  @@map("order_items")
}

// =========================================================
// PAYMENT
// =========================================================

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  amount        Float
  method        String?
  provider      String?
  status        PaymentStatus @default(PENDING)
  transactionId String?
  externalId    String?
  webhookData   String?       @db.Text
  paidAt        DateTime?
  expiredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

// =========================================================
// TICKET
// =========================================================

model Ticket {
  id           String       @id @default(uuid())
  ticketCode   String       @unique
  qrCode       String       @unique
  qrToken      String       @unique // Secure random token for QR validation
  orderId      String
  orderItemId  String?
  buyerId      String
  sellerId     String?
  eventId      String
  ticketTypeId String
  status       TicketStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  buyer      User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([orderId])
  @@index([eventId])
  @@index([sellerId])
  @@index([qrToken])
  @@map("tickets")
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

// =========================================================
// WISHLIST
// =========================================================

model Wishlist {
  id      String @id @default(uuid())
  buyerId String
  eventId String

  createdAt DateTime @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([buyerId, eventId])
  @@map("wishlists")
}

// =========================================================
// NOTIFICATION
// =========================================================

model Notification {
  id         String  @id @default(uuid())
  userId     String
  title      String
  message    String  @db.Text
  type       String? // SELLER_APPLICATION, ORDER_UPDATE, PAYMENT_UPDATE, etc.
  read       Boolean @default(false)
  entityId   String? // Related entity ID for navigation
  entityType String? // "order", "event", "seller_application", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// =========================================================
// SUBSCRIPTION
// =========================================================

model Subscription {
  id        String   @id @default(uuid())
  sellerId  String
  plan      SubType
  startDate DateTime
  endDate   DateTime
  status    String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, PENDING

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("subscriptions")
}

// =========================================================
// LOYALTY TRANSACTION
// =========================================================

model LoyaltyTransaction {
  id      String  @id @default(uuid())
  userId  String
  points  Int // positive = earned, negative = redeemed
  reason  String // "purchase", "first_login", "referral", etc.
  orderId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loyalty_transactions")
}

// =========================================================
// PASSWORD RESET TOKEN
// =========================================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// =========================================================
// ACTIVITY LOG
// =========================================================

model ActivityLog {
  id        String  @id @default(uuid())
  userId    String
  role      String? // ADMIN, BUYER, SELLER, STAFF
  action    String // LOGIN, LOGOUT, REGISTER, CREATE_EVENT, etc.
  entity    String? // "user", "event", "order", "seller_application", etc.
  entityId  String?
  ipAddress String?
  metadata  String? @db.Text // JSON string for extra data
  details   String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}
